                  "maximum": 9007199254740991
                },
                "note": {
                  "type": "string",
                  "minLength": 10
                }
              },
              "required": [
                "doc_slug",
                "page",
                "note"
              ],
              "additionalProperties": false
            }
          },
          "record_gap": {
            "default": null,
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "question",
          "slug",
          "framing",
          "framing_author"
        ],
        "additionalProperties": false
      }
    },
    {
