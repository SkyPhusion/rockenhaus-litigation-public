# Generated at build time
_documents/
cases/
all-documents/
_data/cases.json
_data/pdf_text/
_data/indexnow.json
_site/
.wrangler/
.playwright-mcp

# Python test artifacts. These were committed by accident in the PR that added
# the test suite; every local pytest run regenerates them with different bytes,
# so a tracked copy makes the working tree dirty after any test run and buries
# real changes in noise. A stale .pyc also served MUTATED bytecode during a
# mutation test here, briefly making a restored source look broken.
.coverage
__pycache__/
*.pyc

# Astro / Node
node_modules/
dist/
.astro/

# NOTE: _corpus/ is deliberately NOT ignored.
#
# Everything else generated here is ignored because it is derivable noise. The
# corpus is different: it is the evidentiary surface a public answer engine
# quotes from, so it must be reviewable in a pull request diff BEFORE it can be
# quoted. It is also a hard requirement of the sync tooling, which uploads
# git-tracked files only -- an ignored corpus cannot reach the index at all.
